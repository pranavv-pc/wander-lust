<% layout("/layouts/boilerplate.ejs") %>

    <body>
        <div class="row mt-2">
            <h2 style="text-align: center;">Listing Details</h2>

            <div class="card col-6 offset-3 mt-3">
                <img src="<%= listingInfo.image.url %>" class="card-img-top show-img" alt="listingImage">
                <div class="card-body">
                    <h5 class="card-title">
                        <%=listingInfo.title%>
                    </h5>
                    <p class="card-text">
                        <p><%=listingInfo.description%></p>
                        <p><b>₹ <%=listingInfo.price.toLocaleString()%> / night</b></p>
                        <%=listingInfo.location%>
                        <br>
                        <%=listingInfo.country%>
                    </p>
                    <a href="/listings/<%=listingInfo._id%>/edit" class="btn btn-dark add-btn">Edit</a>
                    <form action="/listings/<%=listingInfo._id%>?_method=DELETE" method="post" style="display: inline;">
                        <button class="btn btn-dark">Delete</button>
                    </form>
                </div>
            </div>

        </div>
    </body>