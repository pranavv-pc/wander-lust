<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
            <% for (let list of allListings) { %>
                <a href="/listings/<%= list.id %>/show" class="listing-link" target="_blank">
                    <div class="card col" >
                    <img src="<%= list.image.url %>" class="card-img-top" alt="listingImage" style="height: 18rem;">
                    <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <h5 class="card-title"><%= list.title %></h5>
                            <b>₹ <%= list.price.toLocaleString() %> / night</b>
                        </div>
                    </div>
                </a>
            <% } %>
        </div>

    </body>